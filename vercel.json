{
  "version": 2,
  "crons": [
    {
      "path": "/api/health",
      "schedule": "*/10 * * * *"
    }
  ],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/admin.html",
      "dest": "/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
